# Server-side environment for driving.hackerman.ge.
#
# deploy/deploy-web.sh copies this to /srv/driving/.env on first bootstrap and
# appends a freshly generated APP_KEY. It is never committed with real values:
# the copy on the server is the only one that carries secrets.

APP_NAME="მართვის მოწმობა"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://driving.hackerman.ge

# Switches the codebase from the device profile picker to Fortify accounts,
# guest sessions and CSRF verification. See app/Support/Platform.php.
APP_PLATFORM=web

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Container logs, collected by Docker's json-file driver.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning

# SQLite lives on the `data` volume, outside the image. WAL lets readers work
# while a write is in flight, and the busy timeout absorbs the rest rather
# than surfacing "database is locked" to a visitor.
DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_BUSY_TIMEOUT=5000

# Sessions and cache stay on the filesystem so they do not compete with the
# application data for SQLite write locks.
SESSION_DRIVER=file
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=driving.hackerman.ge
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Guest accounts with no activity in this many days are deleted nightly by
# app:prune-guest-users.
GUEST_RETENTION_DAYS=30

# Password reset needs a real mailer. Until one is configured, reset mails are
# only written to the log and the feature will not work.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@hackerman.ge"
MAIL_FROM_NAME="${APP_NAME}"
